%% Traffic Light FSM — three normal states plus emergency override
%% Syllabus: SE-11-14
stateDiagram-v2
    direction LR
    [*] --> RED

    RED    --> GREEN  : timer 30s
    GREEN  --> YELLOW : timer 25s
    YELLOW --> RED    : timer 5s

    RED    --> EMERGENCY : 🚨 emergency signal
    GREEN  --> EMERGENCY : 🚨 emergency signal
    YELLOW --> EMERGENCY : 🚨 emergency signal
    EMERGENCY --> RED    : emergency cleared

    note right of RED
        🔴 Stop — 30 s
    end note
    note right of GREEN
        🟢 Go — 25 s
    end note
    note right of YELLOW
        🟡 Caution — 5 s
    end note
    note right of EMERGENCY
        ⚠️ Flashing red
        all traffic stops
    end note

    classDef stop    fill:#ffcdd2,stroke:#C62828,stroke-width:2px
    classDef go      fill:#c8e6c9,stroke:#2E7D32,stroke-width:2px
    classDef caution fill:#fff9c4,stroke:#F57F17,stroke-width:2px
    classDef alarm   fill:#fff3e0,stroke:#E65100,stroke-width:2px

    class RED stop
    class GREEN go
    class YELLOW caution
    class EMERGENCY alarm
