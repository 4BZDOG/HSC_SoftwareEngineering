        O3["Examples<br/>Java · Python · C++ · C#"]
        O1 --- O2 --- O3
    end

    PROC --> SHARED --> OOP

    classDef proc   fill:#e3f2fd,stroke:#1976D2,stroke-width:2px
    classDef shared fill:#f3e5f5,stroke:#6A1B9A,stroke-width:2px
    classDef oop    fill:#e8f5e9,stroke:#2E7D32,stroke-width:2px

    class P1,P2,P3 proc
