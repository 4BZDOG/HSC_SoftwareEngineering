%% Multi-tier Web Architecture — request flow through CDN, app, cache, data tiers
%% Syllabus: SE-12-04
flowchart TB
    subgraph CLIENT["Client tier"]
        Browser["👤 Web Browser<br/>HTML · CSS · JS"]
    end

    subgraph EDGE["Edge tier"]
        CDN["🚀 CDN<br/>Static assets cache"]
    end

    subgraph APP["Application tier"]
        WebServer["🖥️ Web / App Server<br/>Routing · business logic · APIs"]
    end

    subgraph DATA["Data tier"]
        Redis[("⚡ In-memory Cache<br/>Redis / Memcached")]
        Database[("📊 Database<br/>PostgreSQL / MongoDB")]
        Storage[("☁️ File Storage<br/>S3 / object storage")]
    end

    Monitoring["🔔 Monitoring<br/>Metrics · errors · analytics"]

    Browser -- "1 · HTTPS (static)" --> CDN
    Browser -- "2 · HTTPS (dynamic)" --> WebServer
    WebServer -- "3 · lookup" --> Redis
    Redis -- "4 · cache miss" --> Database
    Database -- "5 · fill cache" --> Redis
    WebServer -- "6 · read / write" --> Storage
    WebServer -- "7 · JSON response" --> Browser
    WebServer -. "8 · telemetry" .-> Monitoring

    classDef client  fill:#e3f2fd,stroke:#1976D2,stroke-width:2px
    classDef edge    fill:#fff3e0,stroke:#E65100,stroke-width:2px
    classDef app     fill:#f3e5f5,stroke:#6A1B9A,stroke-width:2px
    classDef data    fill:#e8f5e9,stroke:#2E7D32,stroke-width:2px
    classDef observe fill:#fff9c4,stroke:#F57F17,stroke-width:2px

    class Browser client
    class CDN edge
    class WebServer app
    class Redis,Database,Storage data
    class Monitoring observe
