%% Spam Classifier — simple decision tree with two features
%% Syllabus: SE-12-14
flowchart TD
    Root(["📧 Email received<br/>classify as spam / not spam"]) --> Q1

    Q1{"Contains<br/>'click here'?"}
    Q1 -- Yes --> Q2{"Contains<br/>'free money'?"}
    Q1 -- No  --> Q3{"Unknown<br/>sender?"}

    Q2 -- Yes --> L1["🚫 SPAM<br/>confidence 95%<br/>→ quarantine"]
    Q2 -- No  --> L2["✅ Not spam<br/>confidence 78%<br/>→ inbox"]
    Q3 -- Yes --> L3["🚫 SPAM<br/>confidence 85%<br/>→ quarantine"]
    Q3 -- No  --> L4["✅ Not spam<br/>confidence 92%<br/>→ inbox"]

    classDef start    fill:#e8f5e9,stroke:#2E7D32,stroke-width:2px
    classDef decision fill:#fff9c4,stroke:#F57F17,stroke-width:2px
    classDef spam     fill:#ffcdd2,stroke:#C62828,stroke-width:2px
    classDef ham      fill:#c8e6c9,stroke:#2E7D32,stroke-width:2px

    class Root start
    class Q1,Q2,Q3 decision
    class L1,L3 spam
    class L2,L4 ham
